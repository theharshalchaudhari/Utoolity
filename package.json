{
  "name": "Utoolity",
  "private": true,
  "scripts": {
    "build": "turbo run build --turbo",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "wraith": "node scripts/maintenance/cli.cjs",
    "postgresql": "node tools/database/postgres.cjs",
    "redis:up": "node scripts/redis/start.cjs",
    "clean": "node scripts/clear_unwanted/script.cjs"
  },
  "devDependencies": {
    "prettier": "catalog:",
    "prettier-plugin-tailwindcss-canonical-classes": "^0.1.6",
    "turbo": "catalog:",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=18"
  }
}
